<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_courier_incident_tree" model="ir.ui.view">
        <field name="name">courier.incident.tree</field>
        <field name="model">courier.incident</field>
        <field name="arch" type="xml">
            <list string="Incident Log" 
                  decoration-warning="state == 'followup'"
                  decoration-success="state == 'done'">
                <field name="name" string="Judul Insiden"/>
                <field name="customer_id" string="Pelanggan"/>
                <field name="shipment_id" string="No. Resi" optional="show"/>
                <field name="incident_type" string="Tipe"/>
                <field name="incident_datetime" string="Waktu"/>
                <field name="severity" string="Urgensi"/>
                <field name="state" string="Status" widget="badge" 
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'followup'"
                       decoration-success="state == 'done'"/>
                <field name="resolved_at" string="Selesai pada" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_courier_incident_form" model="ir.ui.view">
        <field name="name">courier.incident.form</field>
        <field name="model">courier.incident</field>
        <field name="arch" type="xml">
                 <form string="Incident Detail">
                <header>
                    <button name="action_mark_followup" 
                            string="Mark Follow-up" 
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_resolve" 
                            string="Resolve" 
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'followup'"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,followup,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g., Paket Rusak di Gudang Jakarta"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Informasi Dasar">
                            <field name="customer_id"/>
                            <field name="shipment_id"/>
                            <field name="incident_type"/>
                            <field name="incident_datetime"/>
                        </group>
                        <group string="Klasifikasi">
                            <field name="severity" widget="radio"/>
                            <field name="resolved_at" invisible="state != 'done'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Detail Insiden">
                            <group>
                                <field name="description" 
                                       placeholder="Jelaskan kronologi kejadian secara detail..."
                                       nolabel="1"/>
                            </group>
                        </page>
                        <page string="Tindak Lanjut">
                            <group>
                                <field name="followup_note" 
                                       placeholder="Catat tindakan yang telah atau akan diambil..."
                                       nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_courier_incident" model="ir.actions.act_window">
        <field name="name">Log Insiden</field>
        <field name="res_model">courier.incident</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Buat Log Insiden Pertama
            </p>
            <p>
                Catat insiden operasional seperti keterlambatan, barang hilang, 
                atau masalah kesehatan kurir untuk tindak lanjut yang terstruktur.
            </p>
        </field>
    </record>
    <menuitem id="menu_courier_root"
              name="Courier"
              sequence="10"
              web_icon="courier_core,static/description/icon.png"/>

    <menuitem id="menu_courier_incident"
              name="Log Insiden"
              parent="menu_courier_root"
              action="action_courier_incident"
              sequence="10"/>

</odoo>
